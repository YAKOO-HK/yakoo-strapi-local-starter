{
  "name": "yakoo-strapi-local-starter",
  "private": false,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build --no-daemon",
    "dev": "turbo run dev --no-daemon",
    "lint": "turbo run lint --no-daemon",
    "build:plugins": "turbo run build --filter=@repo/plugin-*",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.7.6"
  },
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20.0.0 <=24.x.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "aws-sdk",
      "core-js-pure",
      "esbuild",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}